[Unit]
Description=Liar's Tavern independent realtime game
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=liars-tavern
Group=liars-tavern
WorkingDirectory=/opt/liars-tavern/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3279
ExecStart=/usr/bin/node /opt/liars-tavern/current/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
